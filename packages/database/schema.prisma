generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UploadState {
  RECEIVED
  DOWNLOAD_PENDING
  DOWNLOADING
  STAGED
  UPLOAD_PENDING
  UPLOADING
  CREATING_MEDIA
  SYNCED
  RETRY_PENDING
  NEEDS_REVIEW
  FAILED
  UNRECOVERABLE
}

model Owner {
  id           Int               @id @default(1)
  email        String            @unique
  passwordHash String
  settings     Json              @default("{}")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  google       GoogleConnection?
}

model GoogleConnection {
  id                    Int       @id @default(1)
  ownerId               Int       @unique
  owner                 Owner     @relation(fields: [ownerId], references: [id])
  googleAccountId       String?
  encryptedRefreshToken String?
  scopes                String
  status                String
  connectedAt           DateTime  @default(now())
  lastValidatedAt       DateTime?
  lastError             String?
}

model LineGroup {
  id               String   @id @default(uuid())
  lineGroupId      String   @unique
  displayName      String?
  enabled          Boolean  @default(false)
  membershipStatus String   @default("JOINED")
  enabledSince     DateTime?
  membershipAt     DateTime
  googleAlbumId    String?  @unique
  albumCreating    Boolean  @default(false)
  lastEventAt      DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  images           Image[]
}

model Image {
  id                 String          @id @default(uuid())
  lineGroupId        String
  group              LineGroup       @relation(fields: [lineGroupId], references: [lineGroupId])
  channelId          String
  lineMessageId      String
  lineEventTimestamp DateTime
  mimeType           String?
  fileSize           Int?
  width              Int?
  height             Int?
  sha256             String?
  googleMediaItemId  String?         @unique
  productUrl         String?
  uploadStatus       UploadState     @default(RECEIVED)
  stagingPath        String?
  thumbnailPath      String?
  uploadedAt         DateTime?
  errorCode          String?
  lastError          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  attempts           UploadAttempt[]

  @@unique([channelId, lineMessageId])
  @@index([uploadStatus, createdAt])
  @@index([lineGroupId, lineEventTimestamp])
}

model UploadAttempt {
  id            String    @id @default(uuid())
  imageId       String
  image         Image     @relation(fields: [imageId], references: [id])
  attemptNumber Int
  status        String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  errorCode     String?
  errorMessage  String?

  @@unique([imageId, attemptNumber])
}

model WebhookEvent {
  id               String    @id @default(uuid())
  webhookEventId   String    @unique
  eventType        String
  processingStatus String
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  aggregateId String
  payload     Json      @default("{}")
  createdAt   DateTime  @default(now())
  availableAt DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt, availableAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  targetType String
  targetId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
