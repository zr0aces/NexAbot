FROM node:24-bookworm-slim AS base
ENV PNPM_HOME=/opt/pnpm PATH=/opt/pnpm:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates ffmpeg && rm -rf /var/lib/apt/lists/* && corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN pnpm fetch --prod --frozen-lockfile
COPY packages packages
COPY apps apps
RUN pnpm install --prod --offline --frozen-lockfile && pnpm generate

FROM base AS runtime
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps ./apps
COPY VERSION package.json pnpm-workspace.yaml tsconfig.json ./
RUN mkdir -p /data/staging /data/thumbnails && chown -R node:node /data
USER node
ENV NODE_ENV=production
CMD ["node","--import","tsx","apps/worker/main.ts"]
