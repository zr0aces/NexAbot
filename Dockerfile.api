FROM node:24-bookworm-slim AS web-build
ENV PNPM_HOME=/opt/pnpm PATH=/opt/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json VERSION ./
COPY apps/web apps/web
COPY packages/ui packages/ui
COPY scripts/version-control.mjs scripts/version-control.mjs
RUN pnpm install --frozen-lockfile && pnpm build

FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY packages/database/migrations packages/database/migrations
COPY cmd cmd
COPY internal internal
COPY --from=web-build /app/apps/web/dist internal/web/dist
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/rivosnap ./cmd/rivosnap

FROM alpine:3.21 AS runtime
RUN apk add --no-cache ca-certificates ffmpeg tzdata && \
    addgroup -g 1000 node && adduser -u 1000 -G node -s /bin/sh -D node
WORKDIR /app
COPY --from=build /out/rivosnap /app/rivosnap
COPY packages/database/migrations /app/packages/database/migrations
COPY VERSION /app/VERSION
RUN ln -s /app/rivosnap /usr/local/bin/node && \
    mkdir -p /data/staging /data/thumbnails && chown -R node:node /data /app
USER node
ENV NODE_ENV=production
CMD ["/app/rivosnap","api"]
