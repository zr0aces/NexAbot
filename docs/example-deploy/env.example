# Deployment inputs. Copy to .env, then fill the blank settings.
GHCR_OWNER=
LAN_IP=192.168.8.70
WEB_PORT=8068
APP_URL=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/google/callback

# Supply four independent random hex strings (openssl rand -hex 32 each).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://gallery:${POSTGRES_PASSWORD}@postgres:5432/gallery
REDIS_URL=redis://redis:6379
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
BOOTSTRAP_SECRET=

# Provider credentials. Use single quotes around literal values containing $.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
